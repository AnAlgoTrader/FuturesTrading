//@version=6
indicator("SMC Multi-Concept", shorttitle = "SMC MC", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// Inputs (defaults mirror IndicatorBuild/IndicatorConfig.cs)
// =============================================================================

// Shared
grpShared = "Shared"
atrPeriod         = input.int(14, "ATR period", minval = 1, group = grpShared)
rsiPeriod         = input.int(14, "RSI period", minval = 1, group = grpShared)
volumeAvgPeriod   = input.int(50, "Volume average period", minval = 1, group = grpShared)

// Swings / structure
grpStructure = "Market structure"
pivotLookback = input.int(7, "Swing pivot lookback", minval = 1, group = grpStructure)

// Liquidity sweeps
grpSweep = "Liquidity sweeps"
sweepMinWickFraction = input.float(0.5, "Min wick fraction of range", minval = 0.0, maxval = 1.0, step = 0.05, group = grpSweep)

// Fair value gaps
grpFvg = "Fair value gaps"
fvgMinWidthAtr = input.float(3.0, "Min gap width (ATR)", minval = 0.0, step = 0.1, group = grpFvg)
fvgFillFraction = input.float(0.5, "Mitigation fill fraction", minval = 0.0, maxval = 1.0, step = 0.05, group = grpFvg)
fvgBodiesOnly = input.bool(false, "Bodies only (gap between candle bodies)", group = grpFvg)

// Consolidation / breakout
grpConsolidation = "Consolidation"
conMinBars = input.int(8, "Min bars in range", minval = 1, group = grpConsolidation)
conRangeAtrFactor = input.float(1.5, "Max range (x ATR)", minval = 0.0, step = 0.1, group = grpConsolidation)

// Pullbacks
grpPullback = "Pullback"
pullbackLegMinAtr = input.float(1.0, "Min impulse leg (x ATR)", minval = 0.0, step = 0.1, group = grpPullback)
pullbackHealthyMin = input.float(0.236, "Healthy retrace min", minval = 0.0, maxval = 1.0, step = 0.01, group = grpPullback)
pullbackHealthyMax = input.float(0.786, "Healthy retrace max", minval = 0.0, maxval = 1.0, step = 0.01, group = grpPullback)

// Confluence gate (M7)
grpConfluence = "Confluence gate"
confluenceGate = input.int(2, "Gate (min score)", minval = 0, maxval = 4, group = grpConfluence)
confluenceEmaPeriod = input.int(50, "EMA period", minval = 1, group = grpConfluence)
confluenceVolumeFactor = input.float(1.5, "Volume factor (x avg)", minval = 0.0, step = 0.1, group = grpConfluence)
confluenceBodyAtr = input.float(0.35, "Min body (x ATR)", minval = 0.0, step = 0.05, group = grpConfluence)
confluenceDisplaceAtr = input.float(0.7, "Min range (x ATR)", minval = 0.0, step = 0.05, group = grpConfluence)
confluenceLevelToleranceAtr = input.float(0.35, "Level tolerance (x ATR)", minval = 0.0, step = 0.05, group = grpConfluence)

// Plotting
grpPlot = "Plotting"
showStructure = input.bool(true, "Plot BOS/CHoCH labels", group = grpPlot)
showSweeps = input.bool(true, "Plot liquidity sweeps", group = grpPlot)
showFvg = input.bool(true, "Plot FVG zones", group = grpPlot)

// =============================================================================
// Shared calculators (mirror IndicatorBuild/Indicators/SharedCalculators.cs)
// =============================================================================

atrValue = ta.atr(atrPeriod)
avgVolume = ta.sma(volume, volumeAvgPeriod)
emaTrend = ta.ema(close, confluenceEmaPeriod)

// =============================================================================
// Market structure: swings, BOS, CHoCH  (TODO: port MarketStructureEngine)
// =============================================================================

isSwingHigh = ta.pivothigh(high, pivotLookback, pivotLookback)
isSwingLow = ta.pivotlow(low, pivotLookback, pivotLookback)

var float lastSwingHigh = na
var float lastSwingLow = na
var int trend = 0  // 0 = none, 1 = bullish, -1 = bearish

if not na(isSwingHigh)
    lastSwingHigh := isSwingHigh
if not na(isSwingLow)
    lastSwingLow := isSwingLow

bool bosBull = false
bool bosBear = false
bool chochBull = false
bool chochBear = false

if not na(lastSwingHigh) and close > lastSwingHigh
    if trend <= 0
        chochBull := true
        trend := 1
    else
        bosBull := true
    lastSwingHigh := na

if not na(lastSwingLow) and close < lastSwingLow
    if trend >= 0
        chochBear := true
        trend := -1
    else
        bosBear := true
    lastSwingLow := na

if showStructure
    if bosBull
        label.new(bar_index, low, "BOS", style = label.style_label_up, color = color.new(color.teal, 70), textcolor = color.white)
    if bosBear
        label.new(bar_index, high, "BOS", style = label.style_label_down, color = color.new(color.red, 70), textcolor = color.white)
    if chochBull
        label.new(bar_index, low, "CHoCH", style = label.style_label_up, color = color.new(color.orange, 70), textcolor = color.white)
    if chochBear
        label.new(bar_index, high, "CHoCH", style = label.style_label_down, color = color.new(color.orange, 70), textcolor = color.white)

// =============================================================================
// Liquidity sweeps  (TODO: port LiquiditySweepDetector: detect -> confirm -> fade)
// =============================================================================

// =============================================================================
// Fair value gaps  (TODO: port FvgDetector + mitigation tracking)
// =============================================================================

// =============================================================================
// Consolidation / breakout  (TODO: port ConsolidationEngine)
// =============================================================================

// =============================================================================
// Pullback / retracement  (TODO: port PullbackDetector)
// =============================================================================

// =============================================================================
// Wyckoff ranges  (TODO: port WyckoffEngine)
// =============================================================================

// =============================================================================
// Momentum: exhaustion, squeeze/expansion, divergence  (TODO: port MomentumEngine)
// =============================================================================

// =============================================================================
// Confluence scoring / gating  (TODO: port ConfluenceScorer)
// =============================================================================

// =============================================================================
// Plots
// =============================================================================

plot(emaTrend, "Trend EMA", color = color.new(color.gray, 50))
plot(atrValue, "ATR", display = display.none)
