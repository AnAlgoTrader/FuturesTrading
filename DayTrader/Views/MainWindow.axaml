<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DayTrader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="DayTrader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DayTrader"
        WindowState="Maximized">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="95*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Background="#131722">
            <StackPanel.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TextBlock.value">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </StackPanel.Styles>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Update On:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.UpdateOn, StringFormat='\{0:ddd dd MMM HH:mm\}'}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Funds:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.AvailableFunds}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="BuyingPower:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.BuyingPower}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Eur:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.CashEuro}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Usd:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.CashUsd}" Classes="value" />
            </StackPanel>
            <Button Content="Enter" Command="{Binding OnEnterButtonClick}" Margin="8" />
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Price:" Classes="label" />
                <TextBlock Classes="value">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} ({1:F2}) {2:F2}">
                            <Binding Path="MarketPriceUpdate.Ask" />
                            <Binding Path="MarketPriceUpdate.Spread" />
                            <Binding Path="MarketPriceUpdate.Bid" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <NativeWebView Grid.Column="0" x:Name="Chart" />
            <Border Grid.Column="1" Background="#131722">
                <StackPanel>
                  <StackPanel.Styles>
                    <Style Selector="TextBlock.attr">
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="TextBlock.val">
                        <Setter Property="Foreground" Value="#d1d4dc" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    </StackPanel.Styles>
                <StackPanel Margin="12,16,12,0" Spacing="6">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Symbol" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="MES" Classes="val" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Direction" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="BUY" Classes="val" />
                        </Grid>

                        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Quantity" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="5" Classes="val" />
                        </Grid>

                        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Avg Entry" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="4,215.50" Classes="val" />
                        </Grid>

                        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="4,220.25" Classes="val" />
                        </Grid>

                        <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Unrealized P&amp;L" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="+24.00  (+0.11%)" Classes="val" Foreground="#26a69a" />
                        </Grid>

                        <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Commission" Classes="attr" />
                            <TextBlock Grid.Column="1" Text="2.30" Classes="val" />
                        </Grid>
                    </Grid>
                </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>