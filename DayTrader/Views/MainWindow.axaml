<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DayTrader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="DayTrader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DayTrader"
        WindowState="Maximized">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="95*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Background="#131722">
            <StackPanel.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TextBlock.value">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </StackPanel.Styles>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Update On:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.UpdateOn, StringFormat='\{0:ddd dd MMM HH:mm\}'}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Funds:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.AvailableFunds}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="BuyingPower:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.BuyingPower}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Eur:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.CashEuro}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Usd:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.CashUsd}" Classes="value" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock Text="Expiration:" Classes="label" />
                <TextBlock Text="{Binding AccountInfo.FuturesExpiration, StringFormat='\{0:ddd dd MMM\}'}" Classes="value" />
            </StackPanel>
            <Button Content="{Binding MarketPriceUpdate.Ask, StringFormat='{}{0:F2}'}" Command="{Binding BuyButtonClick}" Background="#26a69a" Foreground="White" Margin="8" />
            <TextBlock Text="{Binding MarketPriceUpdate.Spread, StringFormat='{}{0:F2}'}" Classes="value" />
            <Button Content="{Binding MarketPriceUpdate.Bid, StringFormat='{}{0:F2}'}" Command="{Binding SellButtonClick}" Background="#ef5350" Foreground="White" Margin="8" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <NativeWebView Grid.Column="0"  x:Name="Chart" />
            <StackPanel Grid.Column="1" Background="Red"></StackPanel>
        </Grid>
    </Grid>
</Window>